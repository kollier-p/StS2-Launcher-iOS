<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>STS2MobileIos</AssemblyName>
    <RootNamespace>STS2MobileIos</RootNamespace>
    <GameReferences Condition="'$(GameReferences)' == ''">$(MSBuildThisFileDirectory)../../upstream/game-refs</GameReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseGameStub)' != 'true'">
    <Reference Include="sts2">
      <HintPath>$(GameReferences)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameReferences)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseGameStub)' == 'true'">
    <!-- Compile-only legal API declarations; real sts2.dll comes from Steam on device. -->
    <ProjectReference Include="../STS2GameStub/STS2GameStub.csproj" PrivateAssets="all">
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="GodotSharp" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game download protocol lives in its own buildable, game-independent project. -->
    <Compile Remove="Steam/Downloads/**/*.cs" />
    <ProjectReference Include="../STS2SteamDownloads/STS2SteamDownloads.csproj" />
  </ItemGroup>

</Project>
